# Klüp360 ortam değişkenleri — bu dosyayı .env.local olarak kopyalayıp doldurun.
# Canlı ortamda (Vercel) aynı değişkenleri Project Settings → Environment Variables'a girin.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucuda kullanılır (API uçları). Asla istemciye ya da depoya koymayın.
SUPABASE_SERVICE_ROLE_KEY=

# Uygulamanın genel adresi (e-posta bağlantıları ve ödeme dönüş adresi)
NEXT_PUBLIC_APP_URL=https://www.klup360.com

# ── E-posta (Resend) ──────────────────────────────────────
# Bordro, iletişim formu, denetçi hesabı ve deneme uzatma e-postaları
RESEND_API_KEY=
# Resend'de doğrulanmış alan adından gönderen
RESEND_FROM="Klüp360 <destek@klup360.com>"

# ── Abonelik ödemesi (Lemon Squeezy) ──────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Webhook imzasını doğrulamak için (Lemon Squeezy → Settings → Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── İstek sınırlama (Upstash Redis) ───────────────────────
# Canlıda GEREKLİ: tanımlı değilse sınır her sunucu örneğinin belleğinde tutulur ve
# Vercel'de pratikte çalışmaz (kayıt / iletişim / e-posta uçları kötüye kullanılabilir).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
